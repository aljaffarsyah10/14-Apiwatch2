# ==============================================================================
# APIWatch Production Environment Variables Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.production on your production server.
# NEVER commit .env.production or any real secrets to version control.
# Generate strong secrets using: `openssl rand -hex 32`
# ==============================================================================

# Application Environment & Domains
NODE_ENV=production
PORT=3000
DOMAIN=apiwatch.example.com
APP_URL=https://apiwatch.example.com

# PostgreSQL Database Configuration
# NOTE: Database is strictly internal to Docker and not exposed to the public internet
POSTGRES_DB=apiwatch_prod
POSTGRES_USER=apiwatch_prod_user
POSTGRES_PASSWORD=replace_with_a_super_secure_postgres_password_minimum_32_chars
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Redis Queue & Cache Configuration
# NOTE: Redis is strictly internal to Docker and not exposed to the public internet
REDIS_PASSWORD=replace_with_a_super_secure_redis_password_minimum_32_chars
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Cryptography & Session Secrets
# CRITICAL: Generate with `openssl rand -hex 32`
# AUTH_SECRET is used for HMAC signing of session cookies (prevents tampering)
AUTH_SECRET=generate_with_openssl_rand_hex_32
# ENCRYPTION_KEY is used for AES-256-GCM encryption of sensitive headers/auth in DB (64 hex characters = 32 bytes)
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# Email & Alerting (SMTP)
EMAIL_FROM=APIWatch Alerts <alerts@apiwatch.example.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_replace_with_your_smtp_provider_api_key

# Monitoring Engine Configuration
MONITORING_DEFAULT_TIMEOUT_MS=10000
MONITORING_MAX_REDIRECTS=5
MONITORING_MAX_CONCURRENCY=10
