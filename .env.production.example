# ==============================================================================
# APIWatch - Production Environment Configuration (.env.production.example)
# ==============================================================================
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env on your production VPS and populate secure values.

# ------------------------------------------------------------------------------
# 1. Core Server & Public Domain
# ------------------------------------------------------------------------------
NODE_ENV=production
DOMAIN=apiwatch.example.com
APP_URL=https://apiwatch.example.com
PORT=3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration (Internal Docker Network)
# ------------------------------------------------------------------------------
POSTGRES_DB=apiwatch
POSTGRES_USER=apiwatch_user
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# Connection URL utilized by Prisma ORM inside the docker bridge network:
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=25&pool_timeout=10"

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Internal Docker Network)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

# ------------------------------------------------------------------------------
# 4. Cryptographic Secrets (MANDATORY: 64-character hex string / 32 bytes)
# ------------------------------------------------------------------------------
# Used for HMAC-SHA256 session token signatures (Prevents session forgery)
# Generate with: openssl rand -hex 32
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_AUTH_SECRET

# Used for AES-256-GCM symmetric database credential & webhook secret encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_ENCRYPTION_KEY

SESSION_COOKIE_NAME="__Host-apiwatch_session"

# ------------------------------------------------------------------------------
# 5. SaaS Billing & Payment Gateway Integration
# ------------------------------------------------------------------------------
# Set to 'false' in true production mode to connect to live Stripe/LemonSqueezy APIs
BILLING_SANDBOX_MODE=false
BILLING_GATEWAY_WEBHOOK_SECRET=REPLACE_WITH_PAYMENT_GATEWAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 6. Outage Alerting & Email Dispatcher (SMTP)
# ------------------------------------------------------------------------------
EMAIL_FROM="APIWatch Alerts <alerts@apiwatch.example.com>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_SMTP_API_KEY

# ------------------------------------------------------------------------------
# 7. Observability, Metrics & SRE Webhook Alerts
# ------------------------------------------------------------------------------
LOG_LEVEL=info
METRICS_ENABLED=true
# Optional Slack/Discord webhook URL for critical operational system errors:
OPS_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/REPLACE/WITH/OPS_WEBHOOK"

# ------------------------------------------------------------------------------
# 8. Automated Database Backup Strategy
# ------------------------------------------------------------------------------
BACKUP_DIR="/opt/apiwatch/backups"
BACKUP_RETENTION_DAYS=14
# Optional S3 / Cloudflare R2 bucket for off-site backup synchronization
BACKUP_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
