# ==============================================================================
# APIWatch - Development Environment Variables (.env.example)
# ==============================================================================

# Core App Settings
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://apiwatch_dev:postgres@localhost:5432/apiwatch_dev?schema=public&connection_limit=10"

# Redis Connection (BullMQ queues, rate limiting, and dual-layer cache)
REDIS_URL="redis://localhost:6379"

# Security & Cryptography Keys
# Tip: Generate 32-byte hex keys with `openssl rand -hex 32`
AUTH_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
SESSION_COOKIE_NAME="apiwatch_session"

# SaaS Billing & Subscriptions (Sandbox / Mock gateway mode for dev)
BILLING_SANDBOX_MODE=true
BILLING_GATEWAY_WEBHOOK_SECRET="whsec_sandbox_development_mock_key"

# Email Outage Alerts (SMTP Configuration)
EMAIL_FROM="APIWatch Alerts <alerts@example.com>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""

# Observability & Structured Logging
LOG_LEVEL=debug
METRICS_ENABLED=true
OPS_ALERT_WEBHOOK_URL="https://httpbin.org/post"

# Backup Configuration
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=7
